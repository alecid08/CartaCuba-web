---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import TourCard from '../components/TourCard.astro';

const base = import.meta.env.BASE_URL;
const cleanBase = base.endsWith('/') ? base : `${base}/`;
---

<BaseLayout title="Naturaleza y Fauna | CartaCuba" activePage="nature" isNaturePage={true}>
  <!-- Hero Section -->
  <HeroSection
    bgImage={`${cleanBase}images/nature-hero.webp`}
    bgWidth={512}
    bgHeight={293}
    badgeText="BIODIVERSIDAD DE CAMAGÜEY"
    badgeClass="text-primary bg-primary-fixed/30 border border-primary/20 mb-6"
    badgeIcon="eco"
    title="Un Santuario de <br/><span class='text-primary italic'>Patrimonio Vivo</span>"
    description="Viaja al corazón del archipiélago. Desde el vibrante Cartacuba hasta las antiguas palmas de la sabana, Camagüey preserva el espíritu crudo y rítmico de la naturaleza cubana."
    heightClass="h-[870px]"
    showExperts={true}
  >
    <button class="bg-primary text-on-primary px-8 py-4 rounded-full font-label-md hover:bg-primary-container transition-all flex items-center gap-2">
      Explorar Áreas Protegidas
      <span class="material-symbols-outlined">arrow_forward</span>
    </button>
    <button class="border border-primary text-primary px-8 py-4 rounded-full font-label-md hover:bg-primary/5 transition-all">
      Base de Datos de Especies
    </button>
  </HeroSection>

  <main class="relative">
    <!-- Species Spotlight: Cartacuba -->
    <section class="py-24 bg-surface-container-low relative">
      <div class="organic-grain absolute inset-0"></div>
      <div class="px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto relative z-10">
        <div class="grid md:grid-cols-2 gap-16 items-center">
          <div class="relative">
            <div class="leaf-corner overflow-hidden aspect-[4/5] shadow-xl">
              <img class="w-full h-full object-cover" alt="Cartacuba bird (Todus multicolor)" src={`${cleanBase}images/cartacuba-retrato.webp`} width="287" height="512" loading="lazy">
            </div>
            <div class="absolute -bottom-8 -right-8 bg-primary-fixed p-8 leaf-corner shadow-lg max-w-[200px]">
              <span class="text-on-primary-fixed font-headline-sm block mb-2 font-semibold">Todus multicolor</span>
              <p class="text-on-primary-fixed/90 text-[12px] uppercase tracking-widest font-bold">Joya Endémica</p>
            </div>
          </div>
          <div>
            <h2 class="font-headline-md text-headline-md text-on-surface mb-6 font-semibold">El Cartacuba: <br/>Un Espectro Vivo</h2>
            <p class="font-body-lg text-body-lg text-on-surface-variant mb-6">
              El homónimo de nuestra marca, el <em>Cartacuba</em> (Todus multicolor), es una diminuta maravilla de la biosfera. Midiendo apenas 11 centímetros, esta criatura iridiscente encarna la vibrante resiliencia de los bosques de Camagüey.
            </p>
            <ul class="space-y-4 mb-8">
              <li class="flex items-start gap-4">
                <span class="material-symbols-outlined text-primary p-1 bg-primary/10 rounded-lg">nest_multi_room</span>
                <div>
                  <strong class="text-on-surface block font-bold">Hábitat Único</strong>
                  <span class="text-body-md text-on-surface-variant">Anida en madrigueras de tierra excavadas en bancos verticales a lo largo de senderos sombreados.</span>
                </div>
              </li>
              <li class="flex items-start gap-4">
                <span class="material-symbols-outlined text-primary p-1 bg-primary/10 rounded-lg">palette</span>
                <div>
                  <strong class="text-on-surface block font-bold">El Rojo "Cartacuba"</strong>
                  <span class="text-body-md text-on-surface-variant">Conocido por su distintiva garganta roja brillante y su vibrante plumaje verde metálico.</span>
                </div>
              </li>
            </ul>
            <div class="p-6 bg-surface-container-highest rounded-xl border-l-4 border-primary">
              <p class="italic text-on-surface font-headline-sm">"En el silencio de la Sierra del Chorrillo, el chasquido del pico de un Cartacuba es el ritmo del bosque."</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive Biodiversity Bento Grid -->
    <section class="py-24 bg-background">
      <div class="px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
        <div class="text-center mb-16">
          <h2 class="font-headline-md text-headline-md text-on-surface mb-4 font-semibold">Portafolio de Biodiversidad</h2>
          <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mx-auto">Descubre la intrincada red de vida que hace de Camagüey un centro de endemismo reconocido mundialmente.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-4 md:grid-rows-2 gap-6 h-auto md:h-[800px]">
          <!-- Large Card: Flora -->
          <TourCard
            type="experience"
            cardClass="md:col-span-2 md:row-span-2 relative group overflow-hidden leaf-corner bg-surface-container-low shadow-sm hover:shadow-xl transition-all border border-outline-variant/30 h-full"
            image={`${cleanBase}images/flora-sierra-cubitas.webp`}
            badgeText="Flora"
            badgeClass="bg-primary"
            title="Bosques de la Sierra de Cubitas"
            description="Hogar de más de 300 especies de helechos y la prehistórica Microcycas calocoma."
          />

          <!-- Medium Card: Reptiles -->
          <div class="md:col-span-2 relative group overflow-hidden rounded-xl bg-surface-container shadow-sm border border-outline-variant/30">
            <div class="grid md:grid-cols-2 h-full">
              <div class="p-8 flex flex-col justify-center">
                <span class="text-primary font-label-md mb-2">Reptiles Endémicos</span>
                <h3 class="font-headline-sm text-on-surface mb-3 font-semibold">Majá de Santa María</h3>
                <p class="text-body-md text-on-surface-variant mb-4">Un majestuoso depredador de las cuevas de piedra caliza, esencial para el equilibrio del ecosistema.</p>
                <a class="text-primary font-label-md flex items-center gap-1 group-hover:gap-2 transition-all" href="#">Aprende más <span class="material-symbols-outlined">chevron_right</span></a>
              </div>
              <div class="relative overflow-hidden">
                <img class="w-full h-full object-cover group-hover:scale-105 transition-transform" alt="Exotic reptile" src={`${cleanBase}images/reptil-maja-santamaria.webp`} width="512" height="512" loading="lazy">
              </div>
            </div>
          </div>
          
          <!-- Small Card: Conservation -->
          <div class="relative group overflow-hidden rounded-xl bg-primary-container p-8 flex flex-col justify-between">
            <span class="material-symbols-outlined text-on-primary-container text-4xl" style="font-variation-settings: 'FILL' 1;">landscape</span>
            <div>
              <h3 class="text-on-primary-container font-headline-sm mb-2 font-semibold">Reserva Ecológica</h3>
              <p class="text-on-primary-container/80 text-label-md">Programas de protección Limones-Tuabaquey para la fauna local.</p>
            </div>
          </div>
          
          <!-- Small Card: Maps -->
          <div class="relative group overflow-hidden rounded-xl border border-outline-variant/30 bg-surface-container-highest">
            <img class="absolute inset-0 w-full h-full object-cover opacity-50 grayscale hover:grayscale-0 transition-all duration-500" alt="Topographical map representation" src={`${cleanBase}images/mapa-senderos-naturaleza.webp`} width="512" height="512" loading="lazy">
            <div class="absolute inset-0 flex flex-col items-center justify-center p-6 text-center">
              <span class="material-symbols-outlined text-primary mb-2">map</span>
              <h3 class="font-label-md text-on-surface font-semibold">Senderos de Observación</h3>
              <p class="text-[12px] text-on-surface-variant mt-1">Guía SIG Interactiva</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Local Flora Grid -->
    <section class="py-24 bg-surface-container-high">
      <div class="px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
        <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-6">
          <div class="max-w-xl">
            <h2 class="font-headline-md text-headline-md text-on-surface mb-4 font-semibold">Maravillas Botánicas</h2>
            <p class="font-body-lg text-body-lg text-on-surface-variant">La flora de Camagüey es un testimonio de resiliencia, desde los cactus secos de la costa hasta las exuberantes orquídeas de las montañas.</p>
          </div>
          <div class="flex gap-2">
            <button class="p-3 rounded-full border border-primary/20 bg-background text-primary hover:bg-primary hover:text-on-primary transition-all">
              <span class="material-symbols-outlined">west</span>
            </button>
            <button class="p-3 rounded-full border border-primary/20 bg-background text-primary hover:bg-primary hover:text-on-primary transition-all">
              <span class="material-symbols-outlined">east</span>
            </button>
          </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-gutter">
          <!-- Flora Item 1 -->
          <div class="group">
            <div class="aspect-square rounded-2xl overflow-hidden mb-4 shadow-sm group-hover:shadow-md transition-shadow">
              <img class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" alt="Wild Orchid" src={`${cleanBase}images/orquidea-silvestre.webp`} width="512" height="512" loading="lazy">
            </div>
            <h4 class="font-headline-sm text-on-surface font-semibold">Orquídea Silvestre</h4>
            <p class="text-label-md text-primary uppercase tracking-wider mt-1">Orchidaceae</p>
          </div>
          <!-- Flora Item 2 -->
          <div class="group">
            <div class="aspect-square rounded-2xl overflow-hidden mb-4 shadow-sm group-hover:shadow-md transition-shadow">
              <img class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" alt="Coral Shrub" src={`${cleanBase}images/palo-de-coral.webp`} width="512" height="512" loading="lazy">
            </div>
            <h4 class="font-headline-sm text-on-surface font-semibold">Palo de Coral</h4>
            <p class="text-label-md text-primary uppercase tracking-wider mt-1">Hamelia patens</p>
          </div>
          <!-- Flora Item 3 -->
          <div class="group">
            <div class="aspect-square rounded-2xl overflow-hidden mb-4 shadow-sm group-hover:shadow-md transition-shadow">
              <img class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" alt="Yarey Palm" src={`${cleanBase}images/palma-yarey.webp`} width="512" height="512" loading="lazy">
            </div>
            <h4 class="font-headline-sm text-on-surface font-semibold">Palma Yarey</h4>
            <p class="text-label-md text-primary uppercase tracking-wider mt-1">Coccothrinax</p>
          </div>
          <!-- Flora Item 4 -->
          <div class="group">
            <div class="aspect-square rounded-2xl overflow-hidden mb-4 shadow-sm group-hover:shadow-md transition-shadow">
              <img class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" alt="Tree Fern" src={`${cleanBase}images/helecho-cyatheales.webp`} width="512" height="512" loading="lazy">
            </div>
            <h4 class="font-headline-sm text-on-surface font-semibold">Helecho Arborescente</h4>
            <p class="text-label-md text-primary uppercase tracking-wider mt-1">Cyatheales</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="py-24 relative overflow-hidden">
      <div class="absolute inset-0 bg-primary"></div>
      <div class="absolute top-0 right-0 w-1/3 h-full opacity-10">
        <span class="material-symbols-outlined text-[400px] text-white rotate-12 select-none" style="font-variation-settings: 'FILL' 1;">eco</span>
      </div>
      <div class="px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto relative z-10 text-center">
        <h2 class="font-display-lg text-white mb-8">¿Listo para un descubrimiento salvaje?</h2>
        <p class="text-white/90 text-body-lg mb-12 max-w-2xl mx-auto">Únete a nuestros recorridos centrados en la conservación a través de la Sierra del Chorrillo y sé testigo de primera mano de la majestuosidad de la biodiversidad de Camagüey.</p>
        <div class="flex flex-col sm:flex-row justify-center gap-6">
          <button class="bg-primary-fixed text-on-primary-fixed px-10 py-5 rounded-full font-label-md hover:scale-105 transition-all shadow-lg">
            Reservar un Recorrido de Naturaleza
          </button>
          <button class="bg-white/10 backdrop-blur-md text-white border border-white/20 px-10 py-5 rounded-full font-label-md hover:bg-white/20 transition-all">
            Apoyar la Conservación
          </button>
        </div>
      </div>
    </section>
  </main>

  <!-- Offset Map FAB so it doesn't overlap the WhatsApp FAB -->
  <button class="fixed bottom-28 right-8 bg-primary text-on-primary w-16 h-16 rounded-full shadow-2xl flex items-center justify-center hover:scale-110 transition-transform z-40 group">
    <span class="material-symbols-outlined text-3xl">map</span>
    <span class="absolute right-20 bg-on-surface text-surface px-4 py-2 rounded-lg text-label-md opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none">Explorar Mapa</span>
  </button>
</BaseLayout>
