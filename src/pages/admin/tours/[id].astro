---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getTour } from '../../../lib/db.js';

const { id } = Astro.params;
const tour = await getTour(id);

if (!tour) {
  return Astro.redirect('/admin/tours/');
}

const saved = Astro.url.searchParams.get('saved') === '1';
---

<AdminLayout title={`Editar ${tour.title}`}>
  <h1>Editar tour</h1>
  {saved && <p style="color:#155724; background:#d4edda; padding:0.75rem 1rem; border-radius:6px;">Cambios guardados.</p>}

  <form method="POST" action="/admin/api/tours-update">
    <input type="hidden" name="id" value={tour.id} />

    <div class="field-row">
      <div>
        <label for="title">Título</label>
        <input type="text" id="title" name="title" value={tour.title} required />
      </div>
      <div>
        <label for="category">Categoría</label>
        <input type="text" id="category" name="category" value={tour.category} required />
      </div>
    </div>

    <div class="field-row">
      <div>
        <label for="badgeIcon">Ícono (Material Symbols)</label>
        <input type="text" id="badgeIcon" name="badgeIcon" value={tour.badgeIcon} />
      </div>
      <div>
        <label for="duration">Duración</label>
        <input type="text" id="duration" name="duration" value={tour.duration} />
      </div>
    </div>

    <div class="field-row">
      <div>
        <label for="price">Precio base (USD, entero)</label>
        <input type="number" id="price" name="price" value={tour.price} required />
      </div>
      <div>
        <label for="priceDisplay">Texto de rango de precio</label>
        <input type="text" id="priceDisplay" name="priceDisplay" value={tour.priceDisplay} placeholder="Ej. $25–35 USD" />
      </div>
    </div>

    <label for="image-input">Imagen de portada</label>
    <input type="file" id="image-input" accept="image/jpeg,image/png,image/webp,image/avif" />
    <p class="field-hint">Recomendado: 1920×1080px mínimo (16:9), JPEG/WebP/AVIF, máx 10MB. Se usa en portada, tarjeta de catálogo y carrusel de inicio.</p>
    <input type="hidden" id="image-value" name="image" value={tour.image} />

    <label for="shortDescription">Descripción corta</label>
    <textarea id="shortDescription" name="shortDescription">{tour.shortDescription}</textarea>

    <label for="fullDescription">Descripción completa</label>
    <textarea id="fullDescription" name="fullDescription">{tour.fullDescription}</textarea>

    <label for="included">Qué incluye (JSON array de strings)</label>
    <textarea id="included" name="included">{JSON.stringify(tour.included, null, 2)}</textarea>

    <label for="excluded">No incluye (JSON array de strings)</label>
    <textarea id="excluded" name="excluded">{JSON.stringify(tour.excluded, null, 2)}</textarea>

    <label for="gallery-input">Imágenes de galería</label>
    <input type="file" id="gallery-input" multiple accept="image/jpeg,image/png,image/webp,image/avif" />
    <p class="field-hint">Recomendado: 1200×900px mínimo (4:3), JPEG/WebP/AVIF, máx 10MB c/u.</p>
    <input type="hidden" id="gallery-value" name="galleryImages" value={JSON.stringify(tour.galleryImages)} />

    <label for="itinerary">Itinerario (JSON array de {'{'}time, title, desc{'}'})</label>
    <textarea id="itinerary" name="itinerary" style="min-height: 200px;">{JSON.stringify(tour.itinerary, null, 2)}</textarea>

    <button type="submit">Guardar cambios</button>
    <a class="btn secondary" href="/admin/tours/" style="margin-left: 0.5rem;">Cancelar</a>
  </form>

  <script is:inline define:vars={{ tourId: tour.id, initialImage: tour.image, initialGallery: tour.galleryImages }}>
    document.addEventListener('DOMContentLoaded', () => {
      FilePond.registerPlugin(
        FilePondPluginImagePreview,
        FilePondPluginFileValidateType,
        FilePondPluginFileValidateSize,
        FilePondPluginImageValidateSize
      );

      const imageValueInput = document.getElementById('image-value');
      const coverPond = FilePond.create(document.getElementById('image-input'), {
        allowMultiple: false,
        acceptedFileTypes: ['image/jpeg', 'image/png', 'image/webp', 'image/avif'],
        maxFileSize: '10MB',
        imageValidateSizeMinWidth: 1920,
        imageValidateSizeMinHeight: 1080,
        labelIdle: 'Arrastra la imagen de portada o <span class="filepond--label-action">búscala</span>',
        server: { process: `/admin/api/upload-image?tourId=${encodeURIComponent(tourId)}&kind=cover` },
        files: initialImage ? [{ source: initialImage, options: { type: 'local' } }] : [],
      });
      coverPond.on('processfile', (error, file) => {
        if (error) return;
        imageValueInput.value = file.serverId;
      });
      coverPond.on('removefile', () => {
        imageValueInput.value = '';
      });

      const galleryValueInput = document.getElementById('gallery-value');
      let galleryUrls = Array.isArray(initialGallery) ? [...initialGallery] : [];
      const galleryPond = FilePond.create(document.getElementById('gallery-input'), {
        allowMultiple: true,
        acceptedFileTypes: ['image/jpeg', 'image/png', 'image/webp', 'image/avif'],
        maxFileSize: '10MB',
        imageValidateSizeMinWidth: 1200,
        imageValidateSizeMinHeight: 900,
        labelIdle: 'Arrastra imágenes de galería o <span class="filepond--label-action">búscalas</span>',
        server: { process: `/admin/api/upload-image?tourId=${encodeURIComponent(tourId)}&kind=gallery` },
        files: galleryUrls.map((url) => ({ source: url, options: { type: 'local' } })),
      });

      function syncGalleryValue() {
        galleryValueInput.value = JSON.stringify(galleryUrls);
      }

      galleryPond.on('processfile', (error, file) => {
        if (error) return;
        galleryUrls.push(file.serverId);
        syncGalleryValue();
      });
      galleryPond.on('removefile', (error, file) => {
        if (error) return;
        galleryUrls = galleryUrls.filter((url) => url !== file.serverId);
        syncGalleryValue();
      });
    });
  </script>
</AdminLayout>
