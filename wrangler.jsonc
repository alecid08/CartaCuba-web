{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cartacuba",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "cartacuba.org", "custom_domain": true },
    { "pattern": "www.cartacuba.org", "custom_domain": true }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cartacuba-db",
      "database_id": "0bf8aa1f-a9bb-4db2-ac32-95a3ae8015eb",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "cartacuba-images"
    }
  ],
  "observability": {
    "enabled": true
  }
}
