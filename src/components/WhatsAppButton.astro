---
interface Props {
  message?: string;
}

const { message = "Hola, me gustaría obtener más información sobre los recorridos de CartaCuba." } = Astro.props;
---

<a
  data-wa-msg={message}
  target="_blank"
  rel="noopener noreferrer" 
  class="fixed bottom-8 right-8 w-14 h-14 rounded-full bg-[#10B981] hover:bg-[#059669] text-white flex items-center justify-center shadow-lg transition-transform hover:scale-110 active:scale-90 relative z-40 group"
  aria-label="Chat on WhatsApp"
>
  <span class="material-symbols-outlined text-[26px]">chat</span>
  <span class="absolute -top-1 -right-1 w-3.5 h-3.5 bg-[#C35D38] border-2 border-white rounded-full"></span>
  <span class="absolute right-18 bg-on-surface text-surface px-4 py-2 rounded-lg text-label-md opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none">Escríbenos por WhatsApp</span>
</a>
