---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';

const base = import.meta.env.BASE_URL;
const cleanBase = base.endsWith('/') ? base : `${base}/`;
---

<BaseLayout title="CartaCuba | Patrimonio de Camagüey" activePage="heritage">
  <div class="grain-texture fixed inset-0 z-0 pointer-events-none"></div>

  <!-- Hero Section -->
  <HeroSection
    bgImage={`${cleanBase}images/heritage-hero.webp`}
    bgWidth={512}
    bgHeight={293}
    badgeText="Patrimonio de la Humanidad UNESCO"
    badgeClass="inline-block bg-primary-fixed text-on-primary-fixed px-4 py-1 rounded-full font-label-md text-label-md mb-6"
    title="El Corazón Laberíntico de Camagüey"
    description="Descubre una ciudad de plazas asimétricas y callejones serpenteantes, diseñada para confundir a los piratas y preservar un legado de elegancia colonial."
    heightClass="h-[819px]"
    overlayClass="bg-black/40"
  >
    <button class="bg-primary text-on-primary px-8 py-3 rounded-full font-label-md text-label-md shadow-lg hover:shadow-xl transition-all">Explorar Mapa</button>
    <button class="border-2 border-primary text-primary px-8 py-3 rounded-full font-label-md text-label-md hover:bg-primary/5 transition-all">Ver la Historia</button>
  </HeroSection>

  <main class="relative z-10">
    <!-- Map Navigation Section -->
    <section class="py-24 bg-surface-container-low">
      <div class="px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-start">
          <!-- Sidebar: Landmarks -->
          <div class="lg:col-span-4 space-y-6">
            <h2 class="font-headline-md text-headline-md text-on-surface mb-8 font-semibold">Lugares Históricos</h2>
            <!-- Landmark Card 1 -->
            <div class="group bg-surface-container-lowest p-6 rounded-xl border border-outline-variant/30 hover:border-primary transition-all cursor-pointer">
              <div class="flex items-start gap-4">
                <div class="bg-primary-container text-on-primary-container w-10 h-10 rounded-full flex items-center justify-center shrink-0" style="transition: 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);">
                  <span class="material-symbols-outlined">church</span>
                </div>
                <div>
                  <h3 class="font-headline-sm text-headline-sm text-on-surface mb-2 font-semibold">San Juan de Dios</h3>
                  <p class="font-body-md text-body-md text-on-surface-variant">La plaza colonial más completa de Cuba, que cuenta con la Iglesia y el Hospital de San Juan de Dios.</p>
                </div>
              </div>
            </div>
            <!-- Landmark Card 2 -->
            <div class="group bg-surface-container-lowest p-6 rounded-xl border border-outline-variant/30 hover:border-primary transition-all cursor-pointer">
              <div class="flex items-start gap-4">
                <div class="bg-primary text-on-primary w-10 h-10 rounded-full flex items-center justify-center shrink-0">
                  <span class="material-symbols-outlined">park</span>
                </div>
                <div>
                  <h3 class="font-headline-sm text-headline-sm text-on-surface mb-2 font-semibold">Plaza del Carmen</h3>
                  <p class="font-body-md text-body-md text-on-surface-variant">Famosa por sus esculturas de bronce de tamaño natural de ciudadanos locales y la iglesia de Nuestra Señora del Carmen.</p>
                </div>
              </div>
            </div>
            <!-- Landmark Card 3 -->
            <div class="group bg-surface-container-lowest p-6 rounded-xl border border-outline-variant/30 hover:border-primary transition-all cursor-pointer">
              <div class="flex items-start gap-4">
                <div class="bg-tertiary-container text-on-tertiary-container w-10 h-10 rounded-full flex items-center justify-center shrink-0">
                  <span class="material-symbols-outlined">route</span>
                </div>
                <div>
                  <h3 class="font-headline-sm text-headline-sm text-on-surface mb-2 font-semibold">Callejones Serpenteantes</h3>
                  <p class="font-body-md text-body-md text-on-surface-variant">Explora la cuadrícula de calles irregulares, un plan urbano defensivo único que no se encuentra en ningún otro lugar del Caribe.</p>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Map Interface -->
          <div class="lg:col-span-8 sticky top-24">
            <div class="relative rounded-3xl overflow-hidden shadow-2xl border-4 border-surface-container-highest h-[600px]">
              <img alt="Map of Camagüey historic center" class="w-full h-full object-cover grayscale opacity-40" src={`${cleanBase}images/mapa-centro-historico.webp`} width="512" height="512" loading="lazy">
              <!-- Interactive Hotspots -->
              <div class="absolute inset-0 p-8">
                <div class="absolute top-1/3 left-1/4 animate-pulse group-hotspot cursor-pointer">
                  <div class="bg-primary w-6 h-6 rounded-full border-4 border-white shadow-lg"></div>
                  <div class="absolute top-8 -left-4 bg-white p-2 rounded-lg shadow-md font-label-md text-label-md whitespace-nowrap text-on-surface">San Juan de Dios</div>
                </div>
                <div class="absolute bottom-1/4 right-1/3 group-hotspot cursor-pointer">
                  <div class="bg-primary-container w-6 h-6 rounded-full border-4 border-white shadow-lg"></div>
                  <div class="absolute top-8 -left-4 bg-white p-2 rounded-lg shadow-md font-label-md text-label-md whitespace-nowrap text-on-surface">Plaza del Carmen</div>
                </div>
                <div class="absolute top-1/2 right-1/4 group-hotspot cursor-pointer">
                  <div class="bg-tertiary w-6 h-6 rounded-full border-4 border-white shadow-lg"></div>
                  <div class="absolute top-8 -left-4 bg-white p-2 rounded-lg shadow-md font-label-md text-label-md whitespace-nowrap text-on-surface">Catedral</div>
                </div>
              </div>
              <!-- Map Overlay UI -->
              <div class="absolute bottom-6 right-6 flex flex-col gap-2">
                <button class="bg-white/90 backdrop-blur p-2 rounded-lg shadow-md hover:bg-white"><span class="material-symbols-outlined">add</span></button>
                <button class="bg-white/90 backdrop-blur p-2 rounded-lg shadow-md hover:bg-white"><span class="material-symbols-outlined">remove</span></button>
                <button class="bg-white/90 backdrop-blur p-2 rounded-lg shadow-md hover:bg-white"><span class="material-symbols-outlined">my_location</span></button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Architectural Bento Grid -->
    <section class="py-24 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
      <div class="text-center mb-16">
        <h2 class="font-display-lg text-display-lg text-on-surface mb-4 font-bold">Preservando el Espíritu del Tinajón</h2>
        <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mx-auto">La arquitectura de Camagüey se define por sus masivas vasijas de arcilla, techos altos y patios interiores que refrescan el aire tropical.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
        <!-- Large Feature Card -->
        <div class="md:col-span-2 relative h-[500px] rounded-3xl overflow-hidden group cursor-pointer">
          <img alt="Colonial Interior patio with tinajones" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" src={`${cleanBase}images/patio-tinajones-interior.webp`} width="512" height="512" loading="lazy">
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
          <div class="absolute bottom-0 p-10">
            <h3 class="font-headline-md text-headline-md text-white mb-2 font-semibold">Patios Interiores</h3>
            <p class="text-white/80 font-body-md text-body-md">Los pulmones de la casa colonial, diseñados para la ventilación y la recolección de lluvia.</p>
          </div>
        </div>
        <!-- Secondary Feature Card -->
        <div class="bg-surface-container-highest p-10 rounded-3xl flex flex-col justify-between border border-outline-variant/30">
          <div>
            <span class="material-symbols-outlined text-primary text-5xl mb-6">architecture</span>
            <h3 class="font-headline-sm text-headline-sm text-on-surface mb-4 font-semibold">Esfuerzos de Preservación</h3>
            <p class="font-body-md text-body-md text-on-surface-variant">Los programas de restauración en curso mantienen las auténticas fachadas encaladas y la carpintería original del siglo XVIII.</p>
          </div>
          <a class="text-primary font-label-md text-label-md flex items-center gap-2 mt-8 hover:underline" href="#">
            Conoce sobre Nuestro Compromiso <span class="material-symbols-outlined text-sm">arrow_forward</span>
          </a>
        </div>
        <!-- Detail Card 1 -->
        <div class="relative h-[300px] rounded-3xl overflow-hidden group cursor-pointer">
          <img alt="Architectural Detail balcon" class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500" src={`${cleanBase}images/balcon-colonial.webp`} width="512" height="512" loading="lazy">
          <div class="absolute inset-0 bg-black/20 group-hover:bg-transparent transition-all"></div>
        </div>
        <!-- Detail Card 2 -->
        <div class="relative h-[300px] rounded-3xl overflow-hidden group cursor-pointer">
          <img alt="Winding Street of Camagüey" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" src={`${cleanBase}images/calle-camaguey-sinuosa.webp`} width="512" height="341" loading="lazy">
        </div>
        <!-- Detail Card 3 -->
        <div class="relative h-[300px] rounded-3xl overflow-hidden group cursor-pointer">
          <img alt="UNESCO Plaque on ancient wall" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" src={`${cleanBase}images/unesco-placa.webp`} width="512" height="512" loading="lazy">
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-24 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto text-center">
      <div class="bg-primary p-12 md:p-24 rounded-[4rem] text-on-primary relative overflow-hidden">
        <div class="absolute top-0 right-0 w-64 h-64 bg-white/10 organic-shape -translate-y-1/2 translate-x-1/2"></div>
        <div class="absolute bottom-0 left-0 w-48 h-48 bg-black/10 organic-shape translate-y-1/2 -translate-x-1/2"></div>
        <div class="relative z-10">
          <h2 class="font-display-lg text-display-lg mb-6 font-bold">Vive la Historia Viva</h2>
          <p class="font-body-lg text-body-lg mb-10 max-w-xl mx-auto opacity-90">Únete a nuestros expertos locales en patrimonio para un recorrido privado por los secretos del laberinto.</p>
          <button class="bg-white text-primary px-10 py-4 rounded-full font-label-md text-label-md hover:shadow-2xl hover:scale-105 transition-all active:scale-95">Reservar una Caminata Arquitectónica</button>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script is:inline>
  // Hover effect for map hotspots
  document.querySelectorAll('.bg-primary, .bg-primary-container, .bg-tertiary').forEach(point => {
    point.addEventListener('mouseenter', function() {
      this.classList.add('scale-150');
      this.style.transition = 'all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275)';
    });
    point.addEventListener('mouseleave', function() {
      this.classList.remove('scale-150');
    });
  });
</script>
